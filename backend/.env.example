PORT=4000
NODE_ENV=development
CORS_ORIGIN=*

# LLM Providers (Leave empty to use intelligent built-in heuristic engine)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_LLM_PROVIDER=auto

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# Optional PostgreSQL database connection for persistent reviews
# DATABASE_URL="postgresql://user:password@localhost:5432/codereview?schema=public"
